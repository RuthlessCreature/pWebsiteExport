{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pwebsite-export",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-23",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "pomerol.in",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "pomerol_events"
    }
  ],
  "observability": {
    "enabled": true
  }
}
