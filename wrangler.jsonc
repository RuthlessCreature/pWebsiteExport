{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pwebsite-export",
  "compatibility_date": "2026-08-23",
  "routes": [
    {
      "pattern": "pomerol.in",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
